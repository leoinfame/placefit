{
  "name": "Mensalidades PlaceFit",
  "description": "Todo dia as 9h: envia cobranca e avisos da mensalidade e suspende o acesso de quem passou de 5 dias. So vale para inscricoes pagas pelo site.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "args": {},
            "function_name": "rotinaMensalidades"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "mensalidades_placefit",
      "namespace": "base44",
      "version": "1.0"
    }
  }
}