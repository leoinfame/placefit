{
  "name": "CRMMensagem",
  "type": "object",
  "description": "Mensagem recebida ou enviada em conversa comercial do WhatsApp.",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "conversa_id": {
      "type": "string"
    },
    "telefone": {
      "type": "string"
    },
    "direcao": {
      "type": "string",
      "enum": [
        "recebida",
        "enviada"
      ]
    },
    "tipo": {
      "type": "string",
      "enum": [
        "texto",
        "template",
        "imagem",
        "documento",
        "sistema"
      ],
      "default": "texto"
    },
    "conteudo": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "enviada",
        "entregue",
        "lida",
        "erro",
        "recebida"
      ],
      "default": "pendente"
    },
    "meta_message_id": {
      "type": "string"
    },
    "template_nome": {
      "type": "string"
    },
    "erro": {
      "type": "string"
    }
  },
  "required": [
    "owner_id",
    "conversa_id",
    "direcao",
    "conteudo"
  ],
  "x-security": {
    "read": "authenticated",
    "create": "authenticated",
    "update": "authenticated",
    "delete": "authenticated"
  },
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}