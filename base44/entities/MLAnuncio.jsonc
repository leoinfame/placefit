{
  "name": "MLAnuncio",
  "type": "object",
  "properties": {
    "revendedor_id": {
      "type": "string",
      "description": "Usu\u00e1rio dono da loja (LojaConfig.revendedor_id)"
    },
    "supplier_product_id": {
      "type": "string",
      "description": "SupplierProduct exportado (1 an\u00fancio por varia\u00e7\u00e3o)"
    },
    "product_id": {
      "type": "string",
      "description": "ProductTemplate do SupplierProduct"
    },
    "grupo_variacao": {
      "type": "string",
      "description": "Pai da varia\u00e7\u00e3o (ProductTemplate.grupo_variacao), para agrupar na tela"
    },
    "ml_user_id": {
      "type": "string",
      "description": "Conta do ML onde o an\u00fancio foi criado"
    },
    "ml_item_id": {
      "type": "string",
      "description": "ID do an\u00fancio no ML (MLB...)"
    },
    "permalink": {
      "type": "string"
    },
    "categoria_ml": {
      "type": "string"
    },
    "titulo": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "closed",
        "under_review",
        "inactive",
        "erro"
      ],
      "description": "\u00daltimo status conhecido no ML"
    },
    "preco_placefit": {
      "type": "number",
      "description": "Pre\u00e7o da loja PlaceFit no momento do envio"
    },
    "comissao_percentual": {
      "type": "number"
    },
    "comissao_fixa": {
      "type": "number"
    },
    "comissao_fonte": {
      "type": "string",
      "enum": [
        "api",
        "manual"
      ]
    },
    "preco_enviado": {
      "type": "number",
      "description": "Pre\u00e7o final enviado ao ML"
    },
    "ultima_sync": {
      "type": "string",
      "format": "date-time"
    },
    "erro": {
      "type": "string",
      "description": "\u00daltima mensagem de erro do ML, se houver"
    }
  },
  "required": [
    "revendedor_id",
    "supplier_product_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.revendedor_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}