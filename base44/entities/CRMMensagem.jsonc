{
  "name": "CRMMensagem",
  "type": "object",
  "description": "Mensagem recebida ou enviada em conversa comercial do WhatsApp.",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "conversa_id": {
      "type": "string"
    },
    "telefone": {
      "type": "string"
    },
    "direcao": {
      "type": "string",
      "enum": [
        "recebida",
        "enviada"
      ]
    },
    "tipo": {
      "type": "string",
      "enum": [
        "texto",
        "template",
        "imagem",
        "documento",
        "sistema"
      ],
      "default": "texto"
    },
    "conteudo": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "enviada",
        "entregue",
        "lida",
        "erro",
        "recebida"
      ],
      "default": "pendente"
    },
    "meta_message_id": {
      "type": "string"
    },
    "template_nome": {
      "type": "string"
    },
    "erro": {
      "type": "string"
    },
    "origem": {
      "type": "string",
      "enum": [
        "waha",
        "cloud_api",
        "business_app",
        "history",
        "sistema",
        "respondedor_ia"
      ],
      "default": "waha",
      "description": "Canal de origem da mensagem: WAHA (atual), Cloud API, Business App (eco), historico sincronizado, sistema ou respondedor autom\u00e1tico (L\u00e9o da Muscular)"
    },
    "enviada_em": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp original do evento Meta/WhatsApp"
    },
    "atendente_id": {
      "type": "string",
      "description": "C\u00f3pia de CRMConversa.atendente_id para o atendente ler as mensagens das conversas dele. Mant\u00e9m igual \u00e0 conversa ao gravar e ao reatribuir."
    },
    "enviada_por": {
      "type": "string",
      "description": "ID do User que enviou (mensagens enviadas pela equipe). Vazio para recebidas e autom\u00e1ticas."
    },
    "connection_id": {
      "type": "string",
      "description": "ID de whatsapp_connections por onde a mensagem passou"
    }
  },
  "required": [
    "owner_id",
    "conversa_id",
    "direcao",
    "conteudo"
  ],
  "x-security": {
    "read": "authenticated",
    "create": "authenticated",
    "update": "authenticated",
    "delete": "authenticated"
  },
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "data.atendente_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}