{
  "name": "FabricanteChina",
  "type": "object",
  "properties": {
    "nome_fabrica": {
      "type": "string",
      "description": "Nome da Fábrica / Razão Social (China)"
    },
    "id_integracao": {
      "type": "string",
      "description": "Link ou ID de integração 1688/Alibaba"
    },
    "hub": {
      "type": "string",
      "enum": [
        "Shandong",
        "Ningbo",
        "Shenzhen",
        "Guangzhou"
      ],
      "description": "Localização (Hub) para cálculo de frete interno"
    },
    "moeda": {
      "type": "string",
      "enum": [
        "RMB",
        "USD"
      ],
      "default": "RMB",
      "description": "Moeda padrão do fornecedor"
    },
    "lead_time_min": {
      "type": "number",
      "description": "Prazo mínimo de produção em dias"
    },
    "lead_time_max": {
      "type": "number",
      "description": "Prazo máximo de produção em dias"
    },
    "rating_exportacao": {
      "type": "number",
      "description": "Rating de exportação de 1 a 5"
    },
    "ncm": {
      "type": "string",
      "default": "9506.91.00",
      "description": "Código NCM do produto"
    },
    "notas_verificacao": {
      "type": "string",
      "description": "Notas de verificação, certificados de qualidade"
    },
    "taxa_consolidacao": {
      "type": "number",
      "description": "Taxa de consolidação logística em % aplicada automaticamente"
    },
    "contato_nome": {
      "type": "string",
      "description": "Nome do contato na fábrica"
    },
    "contato_wechat": {
      "type": "string",
      "description": "WeChat/WhatsApp do contato"
    },
    "contato_email": {
      "type": "string",
      "description": "Email do contato"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o fabricante está ativo"
    }
  },
  "required": [
    "nome_fabrica",
    "hub"
  ],
  "x-security": {
    "read": "admin",
    "create": "admin",
    "update": "admin",
    "delete": "admin"
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
