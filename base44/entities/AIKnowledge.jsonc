{
  "name": "AIKnowledge",
  "type": "object",
  "properties": {
    "fabricante_id": {
      "type": "string",
      "description": "ID do fabricante dono deste conhecimento (se aplicável)"
    },
    "supplier_id": {
      "type": "string",
      "description": "ID do revendedor dono deste conhecimento (se aplicável)"
    },
    "titulo": {
      "type": "string",
      "description": "Título do conhecimento"
    },
    "conteudo": {
      "type": "string",
      "description": "Conteúdo do conhecimento"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "Produtos",
        "Fornecedores",
        "Frete",
        "Políticas",
        "Procedimentos",
        "FAQ",
        "Outros",
        "Arquivos"
      ],
      "description": "Categoria do conhecimento"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o conhecimento está ativo"
    }
  },
  "required": [
    "titulo",
    "conteudo",
    "categoria"
  ],
  "x-security": {
    "read": "authenticated",
    "create": "public",
    "update": "public",
    "delete": "public"
  },
  "rls": {
    "create": {
      "$or": [
        {
          "data.supplier_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.supplier_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.supplier_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
