{
  "name": "Product",
  "type": "object",
  "properties": {
    "foto": {
      "type": "string",
      "description": "URL da foto do produto"
    },
    "nome": {
      "type": "string",
      "description": "Nome do produto"
    },
    "cod": {
      "type": "string",
      "description": "Código único (SKU) - itemGroupId para Google UCP"
    },
    "gtin": {
      "type": "string",
      "description": "Código de barras EAN/UPC para identificação no Google Shopping"
    },
    "google_category": {
      "type": "string",
      "description": "Categoria oficial do Google Shopping (ex: Sporting Goods > Fitness Equipment)"
    },
    "peso": {
      "type": "number",
      "description": "Peso em kg"
    },
    "dimensoes": {
      "type": "string",
      "description": "Largura x Altura x Profundidade (cm)"
    },
    "und": {
      "type": "string",
      "enum": [
        "peça",
        "par",
        "kg",
        "metro",
        "litro",
        "caixa"
      ],
      "description": "Unidade de venda"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "Anilhas",
        "Acessórios",
        "Aparelhos de Ginástica",
        "Barras",
        "Cabos",
        "Cardiovascular",
        "Complemento",
        "Funcional",
        "Halteres",
        "Musculação",
        "Suportes",
        "Tornozeleiras",
        "Caneleiras"
      ],
      "description": "Categoria do produto"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o produto está ativo no catálogo"
    },
    "fabricante_id": {
      "type": "string",
      "description": "ID do fabricante nacional que criou o produto (se aplicável)"
    },
    "fabricante_nome": {
      "type": "string",
      "description": "Nome do fabricante para facilitar busca"
    },
    "aprovado_produto": {
      "type": "boolean",
      "default": false,
      "description": "Se o produto do fabricante foi aprovado pelo admin"
    },
    "preco_fabricante": {
      "type": "number",
      "description": "Preço sugerido pelo fabricante"
    },
    "origem": {
      "type": "string",
      "enum": [
        "nacional",
        "china"
      ],
      "default": "nacional",
      "description": "Origem do produto: nacional ou importado da China"
    },
    "fabricante_china_id": {
      "type": "string",
      "description": "ID do FabricanteChina (quando origem=china)"
    },
    "fabricante_china_nome": {
      "type": "string",
      "description": "Nome da fábrica chinesa"
    },
    "preco_rmb": {
      "type": "number",
      "description": "Preço de fábrica em RMB (quando origem=china)"
    },
    "cbm_unitario": {
      "type": "number",
      "description": "Volume em m³ por unidade (para cálculo de frete LCL)"
    },
    "ncm": {
      "type": "string",
      "description": "Código NCM do produto"
    }
  },
  "required": [
    "nome",
    "cod",
    "und",
    "categoria"
  ],
  "x-security": {
    "read": "public",
    "create": "public",
    "update": "public",
    "delete": "public"
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
