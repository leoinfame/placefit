{
  "name": "ClienteFiscal",
  "type": "object",
  "description": "Cliente fiscal de um tenant para fins de rascunho NF-e. Isolado por tenant via RLS.",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "ID do User dono do cliente (tenant). Sinonimo de user_id."
    },
    "tipo_pessoa": {
      "type": "string",
      "enum": [
        "Fisica",
        "Juridica"
      ],
      "description": "Tipo de pessoa"
    },
    "cpf_cnpj": {
      "type": "string",
      "description": "CPF ou CNPJ (normalizado, sem pontuacao)"
    },
    "nome_razao_social": {
      "type": "string",
      "description": "Nome ou Razao Social"
    },
    "nome_fantasia": {
      "type": "string",
      "description": "Nome fantasia (apenas PJ)"
    },
    "inscricao_estadual": {
      "type": "string",
      "description": "Inscricao Estadual"
    },
    "email": {
      "type": "string",
      "description": "Email"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone"
    },
    "whatsapp": {
      "type": "string",
      "description": "WhatsApp"
    },
    "endereco": {
      "type": "string",
      "description": "Logradouro"
    },
    "numero": {
      "type": "string",
      "description": "Numero"
    },
    "complemento": {
      "type": "string",
      "description": "Complemento"
    },
    "bairro": {
      "type": "string",
      "description": "Bairro"
    },
    "cidade": {
      "type": "string",
      "description": "Cidade"
    },
    "estado": {
      "type": "string",
      "description": "UF"
    },
    "cep": {
      "type": "string",
      "description": "CEP"
    },
    "total_compras": {
      "type": "number",
      "default": 0,
      "description": "Total de compras realizadas"
    },
    "ultima_compra": {
      "type": "string",
      "format": "date",
      "description": "Data da ultima compra"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Cliente ativo"
    },
    "observacoes": {
      "type": "string",
      "description": "Observacoes"
    }
  },
  "required": [
    "tenant_id",
    "cpf_cnpj",
    "nome_razao_social"
  ],
  "x-security": {
    "read": "authenticated",
    "create": "authenticated",
    "update": "authenticated",
    "delete": "authenticated"
  },
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}