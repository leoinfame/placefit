{
  "name": "Category",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da categoria"
    },
    "subcategorias": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de subcategorias",
      "default": []
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se a categoria está ativa"
    },
    "ordem": {
      "type": "number",
      "description": "Ordem de exibição",
      "default": 0
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
