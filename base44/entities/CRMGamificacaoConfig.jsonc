{
  "name": "CRMGamificacaoConfig",
  "type": "object",
  "description": "Item 024: limites e pesos do placar/sem\u00e1foro do CRM por conta (owner). S\u00f3 configura\u00e7\u00e3o de painel: nada aqui envia mensagem.",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "ID do User dono da conta do CRM"
    },
    "limite_atendimento_dias": {
      "type": "number",
      "default": 2,
      "description": "Dias parados em Atendimento antes de esfriar"
    },
    "limite_orcamento_dias": {
      "type": "number",
      "default": 2,
      "description": "Dias parados em Or\u00e7amento antes de esfriar"
    },
    "limite_negociacao_dias": {
      "type": "number",
      "default": 5,
      "description": "Dias parados em Negocia\u00e7\u00e3o antes de esfriar"
    },
    "valor_alto": {
      "type": "number",
      "default": 5000,
      "description": "Valor de or\u00e7amento considerado alto (R$)"
    },
    "valor_alto_pontos": {
      "type": "number",
      "default": 20
    },
    "valor_medio": {
      "type": "number",
      "default": 2000,
      "description": "Valor de or\u00e7amento considerado m\u00e9dio (R$)"
    },
    "valor_medio_pontos": {
      "type": "number",
      "default": 10
    },
    "contato_recente_pontos": {
      "type": "number",
      "default": 20,
      "description": "Pontos quando o \u00faltimo contato foi nas \u00faltimas 24h"
    },
    "contato_tres_dias_pontos": {
      "type": "number",
      "default": 10,
      "description": "Pontos quando o \u00faltimo contato foi nos \u00faltimos 3 dias"
    },
    "penalidade_dia_sem_retorno": {
      "type": "number",
      "default": 10,
      "description": "Pontos perdidos por dia sem retorno do cliente"
    }
  },
  "required": [
    "owner_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}