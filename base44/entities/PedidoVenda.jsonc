{
  "name": "PedidoVenda",
  "type": "object",
  "description": "Pedido de venda de um tenant. Isolado por tenant via RLS. O status Faturado so pode ser definido por fluxo futuro protegido por retorno SEFAZ valido, nunca pelo rascunho fiscal.",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "ID do vendedor (tenant). Sinonimo de user_id."
    },
    "numero_pedido": {
      "type": "string",
      "description": "Numero do pedido"
    },
    "cliente_id": {
      "type": "string",
      "description": "ID do cliente fiscal"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "cliente_cpf_cnpj": {
      "type": "string",
      "description": "CPF/CNPJ do cliente"
    },
    "data_pedido": {
      "type": "string",
      "format": "date",
      "description": "Data do pedido"
    },
    "status": {
      "type": "string",
      "enum": [
        "Em negociacao",
        "Confirmado",
        "Faturado",
        "Enviado",
        "Entregue",
        "Cancelado"
      ],
      "default": "Em negociacao",
      "description": "Status do pedido. Faturado so via fluxo fiscal autorizado real."
    },
    "itens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "codigo": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "ncm": {
            "type": "string"
          },
          "quantidade": {
            "type": "number"
          },
          "valor_unitario": {
            "type": "number"
          },
          "desconto": {
            "type": "number",
            "default": 0
          },
          "valor_total": {
            "type": "number"
          }
        }
      },
      "description": "Itens do pedido"
    },
    "subtotal": {
      "type": "number",
      "description": "Subtotal dos produtos"
    },
    "desconto": {
      "type": "number",
      "default": 0,
      "description": "Desconto total"
    },
    "valor_frete": {
      "type": "number",
      "default": 0,
      "description": "Valor do frete"
    },
    "valor_total": {
      "type": "number",
      "description": "Valor total do pedido"
    },
    "forma_pagamento": {
      "type": "string",
      "enum": [
        "A vista",
        "Boleto",
        "Cartao",
        "PIX",
        "Parcelado"
      ],
      "description": "Forma de pagamento"
    },
    "status_pagamento": {
      "type": "string",
      "enum": [
        "Pendente",
        "Pago",
        "Atrasado"
      ],
      "default": "Pendente",
      "description": "Status do pagamento"
    },
    "data_vencimento": {
      "type": "string",
      "format": "date",
      "description": "Data de vencimento"
    },
    "data_pagamento": {
      "type": "string",
      "format": "date",
      "description": "Data do pagamento"
    },
    "transportador_id": {
      "type": "string",
      "description": "ID do transportador"
    },
    "transportador_nome": {
      "type": "string",
      "description": "Nome do transportador"
    },
    "status_entrega": {
      "type": "string",
      "enum": [
        "Aguardando",
        "Em transito",
        "Entregue"
      ],
      "default": "Aguardando",
      "description": "Status da entrega"
    },
    "nfe_id": {
      "type": "string",
      "description": "ID do rascunho fiscal gerado (NotaFiscal)"
    },
    "observacoes": {
      "type": "string",
      "description": "Observacoes"
    }
  },
  "required": [
    "tenant_id",
    "cliente_id",
    "itens"
  ],
  "x-security": {
    "read": "authenticated",
    "create": "authenticated",
    "update": "authenticated",
    "delete": "authenticated"
  },
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}