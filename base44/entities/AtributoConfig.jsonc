{
  "name": "AtributoConfig",
  "type": "object",
  "description": "Configuração de atributos do catálogo padronizado. Define quais campos aparecem em cada categoria e quais opções estão disponíveis para campos do tipo select.",
  "properties": {
    "campo": {
      "type": "string",
      "description": "Nome do campo no ProductTemplate (ex: acabamento, tipo_furo)"
    },
    "label": {
      "type": "string",
      "description": "Rótulo de exibição (ex: Acabamento, Tipo de Furo)"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "select",
        "number",
        "boolean",
        "text"
      ],
      "description": "Tipo do campo"
    },
    "opcoes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de opções para campos tipo select"
    },
    "categorias_aplicaveis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Categorias onde este atributo é relevante"
    },
    "ordem": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibição dentro da categoria"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se este atributo está ativo"
    }
  },
  "required": [
    "campo",
    "label",
    "tipo"
  ],
  "x-security": {
    "read": "admin",
    "create": "admin",
    "update": "admin",
    "delete": "admin"
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
