{
  "name": "LojaCliente",
  "type": "object",
  "description": "Cliente final cadastrado na loja online de um revendedor (e-commerce). Criado durante o cadastro/login da vitrine publica. Eh espelhado na entidade Cliente (Meus Clientes) do revendedor via cliente_interno_id.",
  "properties": {
    "revendedor_id": {
      "type": "string",
      "description": "ID do revendedor dono da loja"
    },
    "nome": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "email": {
      "type": "string",
      "description": "Email do cliente"
    },
    "cpf": {
      "type": "string",
      "description": "CPF do cliente"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone/WhatsApp do cliente"
    },
    "senha": {
      "type": "string",
      "description": "Hash da senha do cliente (SHA-256 + salt)"
    },
    "token": {
      "type": "string",
      "description": "Token de sessao gerado no login"
    },
    "cliente_interno_id": {
      "type": "string",
      "description": "ID do registro espelhado na entidade Cliente (Meus Clientes) do revendedor"
    },
    "cep": {
      "type": "string"
    },
    "endereco": {
      "type": "string",
      "description": "Logradouro"
    },
    "numero": {
      "type": "string"
    },
    "complemento": {
      "type": "string"
    },
    "bairro": {
      "type": "string"
    },
    "cidade": {
      "type": "string"
    },
    "estado": {
      "type": "string",
      "description": "UF"
    }
  },
  "required": [
    "revendedor_id",
    "nome",
    "email"
  ],
  "x-security": {
    "read": "authenticated",
    "create": "public",
    "update": "admin",
    "delete": "admin"
  },
  "rls": {
    "read": {
      "$or": [
        {
          "data.revendedor_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}