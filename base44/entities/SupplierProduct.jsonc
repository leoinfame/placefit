{
  "name": "SupplierProduct",
  "type": "object",
  "description": "Vincula um usuário (fabricante ou revendedor) a um ProductTemplate com preço e margem",
  "properties": {
    "supplier_id": {
      "type": "string",
      "description": "ID do usuário logado (fabricante ou revendedor)"
    },
    "fabricante_id": {
      "type": "string",
      "description": "ID do Fabricante dono deste preço (entidade Fabricante). Usado quando o preço é do fabricante e não de um usuário revendedor logado."
    },
    "product_id": {
      "type": "string",
      "description": "ID do ProductTemplate"
    },
    "preco": {
      "type": "number",
      "description": "Preço unitário de fábrica"
    },
    "margem": {
      "type": "number",
      "default": 0,
      "description": "Percentual de margem do revendedor"
    },
    "fabricante_nome": {
      "type": "string",
      "description": "Nome do fabricante cujo preço foi usado (para revendedores)"
    },
    "cod_origem": {
      "type": "string",
      "description": "Código de origem do fabricante (SKU próprio do fornecedor, não segue padrão, apenas referência)"
    },
    "observacoes": {
      "type": "string",
      "description": "Observações opcionais"
    },
    "disponivel": {
      "type": "boolean",
      "default": true,
      "description": "Se o produto está disponível"
    },
    "sale_price": {
      "type": "number",
      "description": "Preço promocional aplicado pelo revendedor"
    },
    "shipping_label": {
      "type": "string",
      "description": "Label de agrupamento de frete"
    },
    "ucp_checkout_url": {
      "type": "string",
      "description": "URL de checkout para integração com Google UCP"
    }
  },
  "required": [
    "product_id"
  ],
  "x-security": {
    "read": "public",
    "create": "public",
    "update": "public",
    "delete": "public"
  }
}