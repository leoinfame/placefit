{
  "name": "CRMConversa",
  "type": "object",
  "description": "Conversa comercial do CRM WhatsApp, isolada por usu\u00e1rio respons\u00e1vel.",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "cliente_id": {
      "type": "string"
    },
    "nome_contato": {
      "type": "string"
    },
    "telefone": {
      "type": "string"
    },
    "etapa": {
      "type": "string",
      "enum": [
        "novo",
        "atendimento",
        "orcamento",
        "negociacao",
        "ganho",
        "perdido"
      ],
      "default": "novo"
    },
    "ultima_mensagem": {
      "type": "string"
    },
    "ultima_interacao": {
      "type": "string",
      "format": "date-time"
    },
    "nao_lidas": {
      "type": "integer",
      "default": 0
    },
    "origem": {
      "type": "string",
      "default": "whatsapp"
    },
    "observacoes": {
      "type": "string"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "pendencia": {
      "type": "string",
      "description": "O que o respondedor autom\u00e1tico prometeu confirmar com o time (dado fora do cat\u00e1logo: pre\u00e7o, frete, prazo, estoque...). Uma linha por pend\u00eancia, com data. Limpar quando o time resolver."
    },
    "pendencia_em": {
      "type": "string",
      "format": "date-time",
      "description": "Quando a \u00faltima pend\u00eancia foi registrada"
    },
    "rascunho_orcamento": {
      "type": "string",
      "description": "JSON do rascunho de or\u00e7amento montado pelo modo gerente (s\u00f3 na conversa do dono). Nada \u00e9 gravado em Pedido sem o 'grava' expl\u00edcito do dono."
    },
    "rascunho_orcamento_em": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o resumo do rascunho foi mostrado ao dono. Vale 30 minutos; vencido, o resumo \u00e9 refeito e n\u00e3o grava."
    }
  },
  "required": [
    "owner_id",
    "nome_contato",
    "telefone"
  ],
  "x-security": {
    "read": "authenticated",
    "create": "authenticated",
    "update": "authenticated",
    "delete": "authenticated"
  },
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}