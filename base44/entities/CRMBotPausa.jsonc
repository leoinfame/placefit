{
  "name": "CRMBotPausa",
  "type": "object",
  "description": "Item 024: estado do atendimento manual por conversa. silenciado=true faz o respondedor autom\u00e1tico ignorar S\u00d3 aquele contato at\u00e9 o dono devolver ao bot. Cada a\u00e7\u00e3o fica no hist\u00f3rico com data e hora. N\u00e3o envia nada.",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "ID do User dono da conta do CRM"
    },
    "conversa_id": {
      "type": "string",
      "description": "ID da CRMConversa controlada manualmente"
    },
    "cliente_id": {
      "type": "string"
    },
    "telefone_chave": {
      "type": "string",
      "description": "Telefone normalizado do contato (s\u00f3 d\u00edgitos), quando existir"
    },
    "silenciado": {
      "type": "boolean",
      "default": true,
      "description": "true = bot silenciado neste contato; false = devolvido ao bot"
    },
    "assumido_em": {
      "type": "string",
      "format": "date-time"
    },
    "assumido_por": {
      "type": "string",
      "description": "Nome/e-mail de quem assumiu"
    },
    "devolvido_em": {
      "type": "string",
      "format": "date-time"
    },
    "registros": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "acao": {
            "type": "string",
            "enum": [
              "assumir",
              "devolver"
            ]
          },
          "em": {
            "type": "string"
          },
          "por": {
            "type": "string"
          }
        }
      },
      "description": "Trilha de assumir/devolver com data e hora"
    }
  },
  "required": [
    "owner_id",
    "conversa_id",
    "silenciado"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}