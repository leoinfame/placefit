{
  "name": "CRMProximoPasso",
  "type": "object",
  "description": "Item 024: pr\u00f3ximo passo registrado pelo dono numa conversa. O aviso de sem\u00e1foro s\u00f3 sai da fila quando existe um registro aqui. Nada \u00e9 enviado ao cliente.",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "conversa_id": {
      "type": "string"
    },
    "descricao": {
      "type": "string",
      "description": "O que vai ser feito, em uma linha (ex.: ligar amanh\u00e3 confirmando frete)"
    },
    "em": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o pr\u00f3ximo passo foi registrado"
    },
    "por": {
      "type": "string",
      "description": "Quem registrou"
    }
  },
  "required": [
    "owner_id",
    "conversa_id",
    "descricao"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}