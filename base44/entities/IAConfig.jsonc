{
  "name": "IAConfig",
  "type": "object",
  "properties": {
    "revendedor_id": {
      "type": "string",
      "description": "ID do revendedor dono desta configuração"
    },
    "agent_name": {
      "type": "string",
      "default": "Assistente",
      "description": "Nome do agente IA"
    },
    "regras": {
      "type": "string",
      "description": "Regras e instruções para o agente (texto longo)"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o agente está ativo"
    },
    "plano": {
      "type": "string",
      "enum": [
        "starter",
        "pro",
        "unlimited"
      ],
      "default": "starter",
      "description": "Plano de serviço IA"
    },
    "mensagem_boas_vindas": {
      "type": "string",
      "description": "Mensagem de boas-vindas enviada ao novo cliente"
    }
  },
  "required": [
    "revendedor_id"
  ],
  "x-security": {
    "read": "authenticated",
    "create": "authenticated",
    "update": "authenticated",
    "delete": "authenticated"
  },
  "rls": {
    "read": {
      "$or": [
        {
          "data.revendedor_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.revendedor_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.revendedor_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.revendedor_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
