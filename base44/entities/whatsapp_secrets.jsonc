{
  "name": "whatsapp_secrets",
  "type": "object",
  "description": "Token de acesso cifrado (AES-GCM) de uma conex\u00e3o oficial WhatsApp. Nunca armazenar token em claro nem devolver segredo ao frontend. A chave de cifragem vive em vari\u00e1vel de ambiente (META_TOKEN_ENC_KEY), fora do banco.",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "ID do User dono do segredo (tenant). Sin\u00f4nimo de user_id."
    },
    "connection_id": {
      "type": "string",
      "description": "ID da whatsapp_connections a que este segredo pertence"
    },
    "encrypted_access_token": {
      "type": "string",
      "description": "Pacote base64 (iv + ciphertext + tag) do token AES-GCM. Nunca exibir nem logar."
    },
    "encryption_version": {
      "type": "string",
      "default": "v1",
      "description": "Vers\u00e3o da chave de cifragem usada (rotaciona sem re-onboarding)"
    },
    "token_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o token expira (se aplic\u00e1vel). Vazio = sem expira\u00e7\u00e3o conhecida."
    },
    "rotated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o token foi rotacionado/reemissido pela \u00faltima vez"
    }
  },
  "required": [
    "tenant_id",
    "connection_id",
    "encrypted_access_token"
  ],
  "x-security": {
    "read": "admin",
    "create": "admin",
    "update": "admin",
    "delete": "admin"
  },
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}