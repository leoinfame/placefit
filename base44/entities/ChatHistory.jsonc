{
  "name": "ChatHistory",
  "type": "object",
  "properties": {
    "revendedor_id": {
      "type": "string",
      "description": "ID do revendedor dono deste chat"
    },
    "client_phone": {
      "type": "string",
      "description": "Número de telefone do cliente (WhatsApp)"
    },
    "user_message": {
      "type": "string",
      "description": "Mensagem do cliente"
    },
    "ai_response": {
      "type": "string",
      "description": "Resposta do agente IA"
    },
    "feedback": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovado",
        "inadequado"
      ],
      "default": "pendente",
      "description": "Feedback sobre a qualidade da resposta"
    },
    "observacoes": {
      "type": "string",
      "description": "Observações do administrador"
    }
  },
  "required": [
    "revendedor_id",
    "client_phone",
    "user_message",
    "ai_response"
  ],
  "x-security": {
    "read": "authenticated",
    "create": "public",
    "update": "authenticated",
    "delete": "authenticated"
  },
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.revendedor_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.revendedor_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.revendedor_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
