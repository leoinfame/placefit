{
  "name": "ConfiguracaoFiscal",
  "type": "object",
  "description": "Configuracao fiscal NF-e modelo 55 por tenant. NAO armazena certificado digital nem senha nesta fase. Status de credenciamento e certificado ficam pendentes ate o contador confirmar. pronta_homologacao so e true quando todos os itens obrigatorios do checklist estao resolvidos.",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "ID do User emitente (tenant). Sinonimo de user_id."
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ da empresa emitente (normalizado, sem pontuacao)"
    },
    "razao_social": {
      "type": "string",
      "description": "Razao social"
    },
    "nome_fantasia": {
      "type": "string",
      "description": "Nome fantasia"
    },
    "inscricao_estadual": {
      "type": "string",
      "description": "Inscricao Estadual (pendente de confirmacao)"
    },
    "regime_tributario": {
      "type": "string",
      "enum": [
        "Simples Nacional",
        "Lucro Presumido",
        "Lucro Real"
      ],
      "description": "Regime tributario (pendente de confirmacao pelo contador)"
    },
    "endereco": {
      "type": "string",
      "description": "Logradouro"
    },
    "numero": {
      "type": "string",
      "description": "Numero"
    },
    "complemento": {
      "type": "string",
      "description": "Complemento"
    },
    "bairro": {
      "type": "string",
      "description": "Bairro"
    },
    "cidade": {
      "type": "string",
      "description": "Cidade"
    },
    "estado": {
      "type": "string",
      "description": "UF do emitente"
    },
    "cep": {
      "type": "string",
      "description": "CEP"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone"
    },
    "email": {
      "type": "string",
      "description": "Email"
    },
    "modelo": {
      "type": "string",
      "default": "55",
      "description": "Modelo do documento fiscal (55 = NF-e)"
    },
    "ambiente": {
      "type": "string",
      "enum": [
        "homologacao",
        "producao"
      ],
      "default": "homologacao",
      "description": "Ambiente de emissao. Homologacao ate integracao real."
    },
    "serie": {
      "type": "string",
      "description": "Serie da NF-e (pendente de confirmacao pelo contador)"
    },
    "proximo_numero": {
      "type": "number",
      "default": 1,
      "description": "Proximo numero de NF-e. Reservado atomicamente pelo servidor, nunca max+1 no cliente."
    },
    "status_credenciamento": {
      "type": "string",
      "enum": [
        "pendente",
        "ativo",
        "suspenso"
      ],
      "default": "pendente",
      "description": "Status de credenciamento na UF. Pendente ate o contador confirmar."
    },
    "certificado_status": {
      "type": "string",
      "enum": [
        "pendente",
        "configurado"
      ],
      "default": "pendente",
      "description": "Status do certificado A1. Pendente nesta fase. NAO armazenamos certificado nem senha."
    },
    "checklist_pendencias": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de pendencias do contador ainda nao resolvidas"
    },
    "pronta_homologacao": {
      "type": "boolean",
      "default": false,
      "description": "So true quando todos os itens obrigatorios do checklist estao resolvidos. Bloqueia emissao se false."
    }
  },
  "required": [
    "tenant_id"
  ],
  "x-security": {
    "read": "authenticated",
    "create": "authenticated",
    "update": "authenticated",
    "delete": "admin"
  },
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}