{
  "name": "Revendedor",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do revendedor"
    },
    "email": {
      "type": "string",
      "description": "Email do revendedor"
    },
    "whatsapp_number": {
      "type": "string",
      "description": "Número de WhatsApp do revendedor (formato: +55XXXXXXXXXX)",
      "unique": true
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ da empresa"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone comercial"
    },
    "endereco": {
      "type": "string",
      "description": "Endereço completo"
    },
    "cidade": {
      "type": "string",
      "description": "Cidade"
    },
    "estado": {
      "type": "string",
      "description": "Estado (UF)"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o revendedor está ativo"
    }
  },
  "required": [
    "nome",
    "email"
  ],
  "x-security": {
    "read": "authenticated",
    "create": "admin",
    "update": "admin",
    "delete": "admin"
  },
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
