{
  "name": "MetodoPagamento",
  "type": "object",
  "description": "Cartão de crédito salvo no Stripe para cobrança recorrente das assinaturas PlaceFit.",
  "properties": {
    "usuario_id": {
      "type": "string",
      "description": "ID do User dono do cartão"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "ID do customer no Stripe"
    },
    "stripe_payment_method_id": {
      "type": "string",
      "description": "ID do payment method no Stripe"
    },
    "card_last4": {
      "type": "string",
      "description": "Últimos 4 dígitos do cartão"
    },
    "card_brand": {
      "type": "string",
      "description": "Bandeira do cartão (visa, mastercard, amex, elo, etc)"
    },
    "card_exp_month": {
      "type": "number",
      "description": "Mês de expiração (1-12)"
    },
    "card_exp_year": {
      "type": "number",
      "description": "Ano de expiração (4 dígitos)"
    },
    "card_holder_name": {
      "type": "string",
      "description": "Nome impresso no cartão"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o cartão está ativo para cobrança"
    }
  },
  "required": [
    "usuario_id",
    "stripe_customer_id",
    "stripe_payment_method_id"
  ],
  "x-security": {
    "read": "authenticated",
    "create": "admin",
    "update": "admin",
    "delete": "admin"
  },
  "rls": {
    "read": {
      "$or": [
        {
          "data.usuario_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
