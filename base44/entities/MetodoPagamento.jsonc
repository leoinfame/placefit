{
  "name": "MetodoPagamento",
  "type": "object",
  "description": "Cart\u00e3o de cr\u00e9dito salvo no Stripe para cobran\u00e7a recorrente das assinaturas PlaceFit.",
  "properties": {
    "usuario_id": {
      "type": "string",
      "description": "ID do User dono do cart\u00e3o"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "ID do customer no Stripe"
    },
    "stripe_payment_method_id": {
      "type": "string",
      "description": "ID do payment method no Stripe"
    },
    "card_last4": {
      "type": "string",
      "description": "\u00daltimos 4 d\u00edgitos do cart\u00e3o"
    },
    "card_brand": {
      "type": "string",
      "description": "Bandeira do cart\u00e3o (visa, mastercard, amex, elo, etc)"
    },
    "card_exp_month": {
      "type": "number",
      "description": "M\u00eas de expira\u00e7\u00e3o (1-12)"
    },
    "card_exp_year": {
      "type": "number",
      "description": "Ano de expira\u00e7\u00e3o (4 d\u00edgitos)"
    },
    "card_holder_name": {
      "type": "string",
      "description": "Nome impresso no cart\u00e3o"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o cart\u00e3o est\u00e1 ativo para cobran\u00e7a"
    }
  },
  "required": [
    "usuario_id",
    "stripe_customer_id",
    "stripe_payment_method_id"
  ],
  "x-security": {
    "read": "authenticated",
    "create": "admin",
    "update": "admin",
    "delete": "admin"
  },
  "rls": {
    "read": {
      "$or": [
        {
          "data.usuario_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}