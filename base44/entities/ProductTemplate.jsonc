{
  "name": "ProductTemplate",
  "type": "object",
  "description": "Catálogo padronizado de tipos de produtos. Cada registro representa uma variação única de produto. Os fabricantes apenas vinculam seu preço a este template via SupplierProduct.",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome completo padronizado do produto (gerado automaticamente a partir dos atributos)"
    },
    "cod": {
      "type": "string",
      "description": "Código SKU único do template (ex: ANI-OLI-EMB-010)"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "Anilhas",
        "Halteres",
        "Dumbbells",
        "Tijolinhos",
        "Pisos",
        "Colchonetes",
        "Kettlebells",
        "Kits",
        "Barras",
        "Puxadores",
        "Suportes",
        "Acessórios",
        "Estruturas",
        "Outros"
      ],
      "description": "Categoria principal do produto"
    },
    "subcategoria": {
      "type": "string",
      "description": "Subcategoria específica (ex: Halter Sextavado, Dumbbell Sextavado)"
    },
    "tipo_anilha": {
      "type": "string",
      "description": "Tipo construtivo da anilha (ex: Vazada, Injetada, Sólida, Bumper) - aplicável apenas para Anilhas"
    },
    "tipo_furo": {
      "type": "string",
      "description": "Tipo de furo - aplicável apenas para Anilhas"
    },
    "acabamento": {
      "type": "string",
      "description": "Acabamento/revestimento do produto"
    },
    "pegada": {
      "type": "string",
      "description": "Tipo de pegada - aplicável para Kits (ex: Cromada, Injetada, W Cromada)"
    },
    "peso_faixa": {
      "type": "string",
      "description": "Faixa de peso do kit (ex: 1-10, 12-30, 10-30)"
    },
    "peso_kg": {
      "type": "number",
      "description": "Peso do produto em kg"
    },
    "peso_fracionado": {
      "type": "boolean",
      "default": false,
      "description": "Se é peso fracionado (ex: 1.5kg, 2.5kg) - usado em anilhas bumper"
    },
    "barra_acabamento": {
      "type": "string",
      "description": "Acabamento da barra central - aplicável para Halteres"
    },
    "bojo_formato": {
      "type": "string",
      "description": "Formato das extremidades (bojos) - aplicável para Halteres e Dumbbells"
    },
    "dumbell_tipo": {
      "type": "string",
      "description": "Tipo construtivo do Dumbbell. OBS: o nome do campo mantem a grafia antiga porque o front-end referencia dumbell_tipo; só o texto exibido foi normalizado."
    },
    "piso_espessura_mm": {
      "type": "number",
      "description": "Espessura do piso em mm (10 ou 15) - aplicável para Pisos"
    },
    "piso_formato": {
      "type": "string",
      "description": "Formato de montagem do piso"
    },
    "peso_peca": {
      "type": "number",
      "description": "Peso por peça em kg (usado para cálculo de frete em produtos vendidos por peça/m², ex: Pisos)"
    },
    "tijolinho_tipo": {
      "type": "string",
      "description": "Tipo de tijolinho - padrão ou guia"
    },
    "tijolinho_torre": {
      "type": "string",
      "description": "Torre para a qual o tijolinho é compatível"
    },
    "und": {
      "type": "string",
      "enum": [
        "peça",
        "par",
        "kg",
        "m²",
        "kit"
      ],
      "description": "Unidade de venda"
    },
    "foto": {
      "type": "string",
      "description": "URL da foto representativa do tipo de produto (única para todos os fabricantes)"
    },
    "google_category": {
      "type": "string",
      "description": "Categoria Google Shopping (ex: Sporting Goods > Exercise & Fitness > Free Weights > Weight Plates)",
      "default": "Sporting Goods > Exercise & Fitness"
    },
    "ncm": {
      "type": "string",
      "description": "Código NCM para fins fiscais",
      "default": "9506.91.00"
    },
    "gtin": {
      "type": "string",
      "description": "Código de barras EAN/GTIN (opcional)"
    },
    "descricao_padrao": {
      "type": "string",
      "description": "Descrição padronizada do produto para uso no Google Shopping e orçamentos"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se este template está ativo no catálogo"
    }
  },
  "required": [
    "nome",
    "cod",
    "categoria",
    "und"
  ],
  "x-security": {
    "read": "public",
    "create": "admin",
    "update": "admin",
    "delete": "admin"
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
