{
  "name": "Unit",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da unidade"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se a unidade está ativa"
    },
    "ordem": {
      "type": "number",
      "description": "Ordem de exibição",
      "default": 0
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
