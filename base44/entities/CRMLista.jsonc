{
  "name": "CRMLista",
  "type": "object",
  "description": "Lista de organiza\u00e7\u00e3o do CRM WhatsApp (segmento ou a\u00e7\u00e3o). Uma conversa pode estar em v\u00e1rias listas (CRMConversa.listas guarda os ids). Diferente de CRMConversa.etapa, que \u00e9 o funil e vale uma por vez.",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "ID do User dono da conta do CRM (tenant)"
    },
    "nome": {
      "type": "string",
      "description": "Nome curto da lista (ex.: Lead do curso, Fabricante)"
    },
    "descricao": {
      "type": "string",
      "description": "Quem entra nesta lista, em uma linha"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "segmento",
        "acao"
      ],
      "default": "segmento",
      "description": "segmento = quem a pessoa \u00e9; acao = o que precisa ser feito (ex.: Retornar esta semana)"
    },
    "cor": {
      "type": "string",
      "description": "Cor de exibi\u00e7\u00e3o em hex (ex.: #2E7D32)"
    },
    "ordem": {
      "type": "integer",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "equipe_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs dos Users da equipe que enxergam esta lista (atendentes). O dono sempre enxerga."
    }
  },
  "required": [
    "owner_id",
    "nome"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "data.equipe_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}