{
  "name": "AcordoFabricante",
  "type": "object",
  "description": "Condicoes comerciais entre a PLACEFIT e o fabricante: quanto a PlaceFit ganha (comissao ou margem) e que desconto a tabela do fabricante recebeu ao ser cadastrada. NAO CONFUNDIR com AcordoComissao, que e o acordo de um revendedor. Este dado e da plataforma e NAO pode ser visivel para revendedor -- por isso a entidade inteira e restrita a admin.",
  "properties": {
    "fabricante_id": {
      "type": "string",
      "description": "ID do Fabricante a que este acordo se refere"
    },
    "fabricante_nome": {
      "type": "string",
      "description": "Razao social do fabricante, para leitura rapida"
    },
    "tipo_remuneracao": {
      "type": "string",
      "enum": [
        "comissao",
        "margem"
      ],
      "default": "comissao",
      "description": "Como a PlaceFit e remunerada: comissao paga pelo fabricante sobre a venda, ou margem aplicada sobre o preco de fabrica"
    },
    "percentual": {
      "type": "number",
      "description": "Percentual da comissao ou da margem da PlaceFit"
    },
    "desconto_tabela": {
      "type": "number",
      "default": 0,
      "description": "Desconto em % que foi aplicado sobre os precos da tabela do fabricante no momento do cadastro"
    },
    "vigencia_inicio": {
      "type": "string",
      "format": "date",
      "description": "Data a partir da qual este acordo vale"
    },
    "documento_origem": {
      "type": "string",
      "description": "Qual tabela ou documento originou estas condicoes"
    },
    "observacoes": {
      "type": "string",
      "description": "Notas internas sobre a negociacao"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se este acordo esta vigente"
    }
  },
  "required": [
    "fabricante_id",
    "percentual"
  ],
  "x-security": {
    "read": "admin",
    "create": "admin",
    "update": "admin",
    "delete": "admin"
  }
}