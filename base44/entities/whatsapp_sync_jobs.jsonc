{
  "name": "whatsapp_sync_jobs",
  "type": "object",
  "description": "Job de sincroniza\u00e7\u00e3o de contatos/hist\u00f3rico de uma conex\u00e3o oficial WhatsApp. Acompanha fases, chunks recebidos/esperados e progresso. Conclus\u00e3o real exige fase 2 com progresso 100.",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "ID do User dono do job (tenant). Sin\u00f4nimo de user_id."
    },
    "connection_id": {
      "type": "string",
      "description": "ID da whatsapp_connections a que o job pertence"
    },
    "sync_type": {
      "type": "string",
      "enum": [
        "history",
        "contacts",
        "full"
      ],
      "default": "history",
      "description": "Tipo de sincroniza\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "em_andamento",
        "concluido",
        "falhou",
        "cancelado"
      ],
      "default": "pendente",
      "description": "Estado do job"
    },
    "current_phase": {
      "type": "number",
      "default": 0,
      "description": "Fase atual (0, 1, 2). Fase 2 com progresso 100 = conclu\u00eddo."
    },
    "progress": {
      "type": "number",
      "default": 0,
      "description": "Progresso percentual consolidado (0-100)"
    },
    "received_chunks": {
      "type": "number",
      "default": 0,
      "description": "Quantos chunks foram recebidos (inclui fora de ordem)"
    },
    "expected_chunks": {
      "type": "number",
      "description": "Quantos chunks a Meta disse que enviaria (se informado)"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o job come\u00e7ou"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o job foi conclu\u00eddo (fase 2, progresso 100)"
    },
    "last_event_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp do \u00faltimo evento recebido para este job"
    },
    "error": {
      "type": "string",
      "description": "Erro do job, quando aplic\u00e1vel"
    }
  },
  "required": [
    "tenant_id",
    "connection_id",
    "sync_type"
  ],
  "x-security": {
    "read": "admin",
    "create": "admin",
    "update": "admin",
    "delete": "admin"
  },
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}