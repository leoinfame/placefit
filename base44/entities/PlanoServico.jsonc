{
  "name": "PlanoServico",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do serviço/plano"
    },
    "slug": {
      "type": "string",
      "description": "Identificador único do serviço (ex: atendente_ia)"
    },
    "descricao": {
      "type": "string",
      "description": "Descrição detalhada do serviço"
    },
    "beneficios": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de benefícios do plano"
    },
    "preco_mensal": {
      "type": "number",
      "description": "Preço mensal em R$"
    },
    "icone": {
      "type": "string",
      "description": "Emoji ou ícone para exibição"
    },
    "cor": {
      "type": "string",
      "description": "Cor de destaque (ex: blue, purple, green)"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o plano está disponível para venda"
    },
    "destaque": {
      "type": "boolean",
      "default": false,
      "description": "Se aparece em destaque"
    }
  },
  "required": [
    "nome",
    "slug",
    "preco_mensal"
  ],
  "x-security": {
    "read": "public",
    "create": "admin",
    "update": "admin",
    "delete": "admin"
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
