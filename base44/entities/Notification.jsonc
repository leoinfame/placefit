{
  "name": "Notification",
  "type": "object",
  "properties": {
    "supplier_id": {
      "type": "string",
      "description": "ID do fornecedor que receberá a notificação"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "novo_produto",
        "alteracao_preco",
        "produto_aprovado",
        "mensagem_placefit"
      ],
      "description": "Tipo da notificação"
    },
    "produto_id": {
      "type": "string",
      "description": "ID do produto relacionado"
    },
    "produto_nome": {
      "type": "string",
      "description": "Nome do produto para facilitar busca"
    },
    "fabricante_id": {
      "type": "string",
      "description": "ID do fabricante que gerou a notificação"
    },
    "fabricante_nome": {
      "type": "string",
      "description": "Nome do fabricante"
    },
    "preco_antigo": {
      "type": "number",
      "description": "Preço anterior (para alterações de preço)"
    },
    "preco_novo": {
      "type": "number",
      "description": "Novo preço"
    },
    "mensagem": {
      "type": "string",
      "description": "Mensagem da notificação"
    },
    "lida": {
      "type": "boolean",
      "default": false,
      "description": "Se a notificação foi lida"
    }
  },
  "required": [
    "supplier_id",
    "tipo",
    "mensagem"
  ],
  "x-security": {
    "create": "public",
    "read": "public",
    "update": "public",
    "delete": "public"
  },
  "rls": {
    "read": {
      "$or": [
        {
          "data.supplier_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.supplier_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.supplier_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
