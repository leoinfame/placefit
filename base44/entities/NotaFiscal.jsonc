{
  "name": "NotaFiscal",
  "type": "object",
  "description": "Rascunho fiscal NF-e modelo 55 por tenant. NENHUMA NF-e real e emitida por esta entidade. Chave de acesso, protocolo, cStat, XML e DANFE sao sempre nulos ate integracao real com SEFAZ. Status RASCUNHO e o unico estado acionavel agora; AUTORIZADA so existe como fluxo futuro protegido por retorno SEFAZ valido.",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "ID do User emitente (tenant). Sinonimo de user_id. Definido pelo servidor a partir do contexto autenticado."
    },
    "pedido_id": {
      "type": "string",
      "description": "ID do PedidoVenda que originou este rascunho"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Chave de idempotencia por tenant + pedido + operacao. Cliques repetidos nao duplicam o rascunho."
    },
    "modelo": {
      "type": "string",
      "default": "55",
      "description": "Modelo do documento fiscal (55 = NF-e)"
    },
    "ambiente": {
      "type": "string",
      "enum": [
        "homologacao",
        "producao"
      ],
      "default": "homologacao",
      "description": "Ambiente de emissao. Homologacao ate integracao real com SEFAZ."
    },
    "serie": {
      "type": "string",
      "description": "Serie da NF-e (pendente de confirmacao pelo contador)"
    },
    "numero": {
      "type": "string",
      "description": "Numero da NF-e. NULO enquanto rascunho. Reservado atomicamente pelo servidor no momento futuro de envio."
    },
    "status": {
      "type": "string",
      "enum": [
        "RASCUNHO",
        "PENDENTE_CONFIGURACAO",
        "PRONTA_HOMOLOGACAO",
        "EM_PROCESSAMENTO",
        "AUTORIZADA",
        "REJEITADA",
        "DENEGADA",
        "CANCELADA",
        "INUTILIZADA",
        "CONTINGENCIA_PENDENTE"
      ],
      "default": "RASCUNHO",
      "description": "Estado do documento fiscal. Transicoes validas: RASCUNHO -> PENDENTE_CONFIGURACAO -> PRONTA_HOMOLOGACAO -> EM_PROCESSAMENTO -> AUTORIZADA/REJEITADA/DENEGADA. AUTORIZADA so via retorno SEFAZ valido."
    },
    "chave_acesso": {
      "type": "string",
      "description": "Chave de acesso de 44 digitos. NULA ate autorizacao SEFAZ real."
    },
    "protocolo": {
      "type": "string",
      "description": "Protocolo de autorizacao SEFAZ. NULO ate autorizacao real."
    },
    "cStat": {
      "type": "string",
      "description": "Codigo de status SEFAZ. NULO ate retorno real."
    },
    "motivo_rejeicao": {
      "type": "string",
      "description": "Motivo de rejeicao/denegacao SEFAZ. NULO ate retorno real."
    },
    "emitente_snapshot": {
      "type": "string",
      "description": "JSON imutavel com snapshot do emitente no momento da preparacao (CNPJ, IE, endereco, regime). Mudancas posteriores nao alteram o rascunho."
    },
    "destinatario_snapshot": {
      "type": "string",
      "description": "JSON imutavel com snapshot do destinatario no momento da preparacao."
    },
    "itens_snapshot": {
      "type": "string",
      "description": "JSON imutavel com snapshot dos itens, valores, frete e pagamentos no momento da preparacao."
    },
    "valores_snapshot": {
      "type": "string",
      "description": "JSON imutavel com snapshot dos totais e parametros tributarios usados."
    },
    "xml_envio_url": {
      "type": "string",
      "description": "Referencia privada ao XML de envio. NULO ate integracao real. Nunca armazenar XML em campo publico."
    },
    "xml_retorno_url": {
      "type": "string",
      "description": "Referencia privada ao XML de retorno SEFAZ. NULO ate integracao real."
    },
    "xml_autorizado_url": {
      "type": "string",
      "description": "Referencia privada ao XML autorizado. NULO ate autorizacao real."
    },
    "danfe_url": {
      "type": "string",
      "description": "Referencia privada ao DANFE. NULO ate autorizacao real."
    },
    "hash_integridade": {
      "type": "string",
      "description": "Hash de integridade do snapshot para deteccao de divergencias."
    },
    "data_preparacao": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o rascunho foi preparado"
    },
    "data_autorizacao": {
      "type": "string",
      "format": "date-time",
      "description": "Quando a NF-e foi autorizada pela SEFAZ. NULO ate autorizacao real."
    },
    "motivo_cancelamento": {
      "type": "string",
      "description": "Motivo de cancelamento. NULO ate cancelamento real."
    },
    "data_cancelamento": {
      "type": "string",
      "format": "date-time",
      "description": "Data de cancelamento. NULO ate cancelamento real."
    },
    "observacoes": {
      "type": "string",
      "description": "Informacoes complementares"
    }
  },
  "required": [
    "tenant_id",
    "pedido_id",
    "idempotency_key",
    "modelo",
    "ambiente",
    "status"
  ],
  "x-security": {
    "read": "authenticated",
    "create": "authenticated",
    "update": "authenticated",
    "delete": "admin"
  },
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}