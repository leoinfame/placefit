{
  "description": "Item 023 (Sr. Leo, 02/11/2026): alertas do Monitor do CRM por revenda (resposta autom\u00e1tica, tabela, funil, sa\u00fade do WhatsApp) e, na fase 2, as d\u00favidas do vendedor autom\u00e1tico. S\u00f3 o sistema cria (functions com service role); o dono da conta l\u00ea e marca como resolvido. tipo \"controle\" \u00e9 marcador interno e n\u00e3o aparece no painel.",
  "properties": {
    "chave": {
      "description": "Identifica a situa\u00e7\u00e3o (evita alerta repetido): ex. orcamento_24h:<conversa>",
      "type": "string"
    },
    "conversa_id": {
      "description": "Conversa do CRM ligada ao alerta, quando houver",
      "type": "string"
    },
    "detalhe": {
      "type": "string"
    },
    "gravidade": {
      "default": "atencao",
      "enum": [
        "info",
        "atencao",
        "grave"
      ],
      "type": "string"
    },
    "notificado_em": {
      "format": "date-time",
      "type": "string"
    },
    "owner_id": {
      "description": "ID do User (revenda) dono do alerta",
      "type": "string"
    },
    "ref_id": {
      "description": "Outro registro ligado (produto, or\u00e7amento, mensagem)",
      "type": "string"
    },
    "resolvido_em": {
      "format": "date-time",
      "type": "string"
    },
    "resolvido_por": {
      "description": "monitor (sumiu sozinho) ou id do usu\u00e1rio",
      "type": "string"
    },
    "status": {
      "default": "aberto",
      "enum": [
        "aberto",
        "resolvido",
        "dispensado"
      ],
      "type": "string"
    },
    "tipo": {
      "description": "Grupo da checagem",
      "enum": [
        "boas_vindas",
        "tabela",
        "funil",
        "saude",
        "duvida",
        "controle"
      ],
      "type": "string"
    },
    "titulo": {
      "type": "string"
    },
    "whatsapp_erro": {
      "type": "string"
    },
    "whatsapp_status": {
      "default": "",
      "enum": [
        "",
        "enviado",
        "aguardando_janela",
        "sem_destino",
        "erro",
        "so_painel"
      ],
      "type": "string"
    }
  },
  "required": [
    "owner_id",
    "tipo",
    "chave",
    "titulo"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object",
  "name": "CRMAlerta"
}