{
  "name": "PedidoCompra",
  "type": "object",
  "description": "Pedido de compra de um revendedor para um fabricante. Isolado por tenant via RLS: revendedor e fabricante do pedido tem acesso; demais usuarios nao. Antes desta versao o acesso era publico (vulnerabilidade corrigida).",
  "properties": {
    "revendedor_id": {
      "type": "string",
      "description": "ID do revendedor que fez a compra (User ID)"
    },
    "revendedor_nome": {
      "type": "string",
      "description": "Nome do revendedor"
    },
    "fabricante_id": {
      "type": "string",
      "description": "ID do fabricante que recebera o pedido (User ID)"
    },
    "fabricante_nome": {
      "type": "string",
      "description": "Nome do fabricante"
    },
    "venda_id": {
      "type": "string",
      "description": "ID da venda que gerou este pedido de compra"
    },
    "numero_pedido": {
      "type": "string",
      "description": "Numero do pedido de compra"
    },
    "data_pedido": {
      "type": "string",
      "format": "date",
      "description": "Data do pedido"
    },
    "itens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "cod": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "quantidade": {
            "type": "number"
          },
          "preco_unitario": {
            "type": "number"
          },
          "subtotal": {
            "type": "number"
          }
        }
      },
      "description": "Lista de produtos do pedido"
    },
    "total": {
      "type": "number",
      "description": "Total do pedido de compra"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "enviado",
        "confirmado",
        "em_producao",
        "despachado",
        "recebido",
        "cancelado"
      ],
      "default": "pendente",
      "description": "Status do pedido de compra"
    },
    "observacoes": {
      "type": "string",
      "description": "Observacoes sobre o pedido"
    }
  },
  "required": [
    "revendedor_id",
    "fabricante_id",
    "venda_id",
    "itens"
  ],
  "x-security": {
    "read": "authenticated",
    "create": "authenticated",
    "update": "authenticated",
    "delete": "authenticated"
  },
  "rls": {
    "read": {
      "$or": [
        {
          "data.revendedor_id": "{{user.id}}"
        },
        {
          "data.fabricante_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.revendedor_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.revendedor_id": "{{user.id}}"
        },
        {
          "data.fabricante_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.revendedor_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}