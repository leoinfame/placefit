{
  "name": "AssinaturaUsuario",
  "type": "object",
  "properties": {
    "usuario_id": {
      "type": "string",
      "description": "ID do usuário assinante"
    },
    "usuario_email": {
      "type": "string",
      "description": "Email do usuário"
    },
    "usuario_nome": {
      "type": "string",
      "description": "Nome/empresa do usuário"
    },
    "plano_id": {
      "type": "string",
      "description": "ID do PlanoServico"
    },
    "plano_slug": {
      "type": "string",
      "description": "Slug do serviço (para verificação rápida)"
    },
    "plano_nome": {
      "type": "string",
      "description": "Nome do plano para referência"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "suspenso",
        "cancelado",
        "trial"
      ],
      "default": "ativo",
      "description": "Status da assinatura"
    },
    "data_inicio": {
      "type": "string",
      "format": "date",
      "description": "Data de início da assinatura"
    },
    "data_vencimento": {
      "type": "string",
      "format": "date",
      "description": "Data de vencimento"
    },
    "data_cancelamento": {
      "type": "string",
      "format": "date",
      "description": "Data em que o usuário cancelou a assinatura"
    },
    "motivo_cancelamento": {
      "type": "string",
      "description": "Motivo do cancelamento informado pelo usuário"
    },
    "cobranca_automatica": {
      "type": "boolean",
      "default": false,
      "description": "Se a cobrança recorrente está ativa no cartão salvo"
    },
    "observacoes": {
      "type": "string",
      "description": "Observações internas do admin"
    }
  },
  "required": [
    "usuario_id",
    "plano_id",
    "plano_slug",
    "status"
  ],
  "x-security": {
    "read": "public",
    "create": "admin",
    "update": "admin",
    "delete": "admin"
  },
  "rls": {
    "read": {
      "$or": [
        {
          "data.usuario_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
