{
  "name": "CRMEtapa",
  "type": "object",
  "description": "Etapa do funil comercial do CRM, configur\u00e1vel por conta (owner). As sete etapas padr\u00e3o nascem com sistema=true: o nome, a cor e a ordem de qualquer etapa podem ser trocados, mas s\u00f3 as etapas criadas pelo usu\u00e1rio podem ser exclu\u00eddas, porque a automa\u00e7\u00e3o do funil grava as chaves padr\u00e3o.",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "ID do User dono da conta do CRM"
    },
    "chave": {
      "type": "string",
      "description": "Identificador est\u00e1vel da etapa, gravado em CRMConversa.etapa. N\u00e3o muda ao renomear."
    },
    "nome": {
      "type": "string",
      "description": "Nome exibido no funil, no seletor da conversa e nos filtros"
    },
    "cor": {
      "type": "string",
      "enum": [
        "slate",
        "blue",
        "cyan",
        "teal",
        "emerald",
        "amber",
        "orange",
        "rose",
        "violet",
        "indigo",
        "pink"
      ],
      "default": "slate",
      "description": "Cor da coluna e do selo da etapa (paleta fixa do painel)"
    },
    "ordem": {
      "type": "number",
      "default": 0,
      "description": "Posi\u00e7\u00e3o da coluna no funil (menor primeiro)"
    },
    "sistema": {
      "type": "boolean",
      "default": false,
      "description": "true = etapa padr\u00e3o do funil autom\u00e1tico (pode renomear e reordenar, n\u00e3o excluir)"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Etapa vis\u00edvel no funil"
    }
  },
  "required": [
    "owner_id",
    "chave",
    "nome"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}