{
  "name": "BaixaInfinitePay",
  "type": "object",
  "description": "Trava de confirmacao: a InfinitePay pode avisar o mesmo pagamento mais de uma vez quase junto. So o registro mais antigo de cada order_nsu processa.",
  "properties": {
    "order_nsu": {
      "type": "string"
    }
  },
  "required": [
    "order_nsu"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}