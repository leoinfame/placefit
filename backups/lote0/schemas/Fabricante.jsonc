{
  "name": "Fabricante",
  "type": "object",
  "description": "Cadastro da fabrica como entidade propria, independente de conta de usuario. O admin cria o fabricante e sobe a tabela dele sem que exista nenhum User; o campo user_id fica vazio e e preenchido depois, quando o fabricante assumir o acesso. Substitui o padrao antigo de criar User-fantasma com email @placefit.com.br.",
  "properties": {
    "razao_social": {
      "type": "string",
      "description": "Razao social completa da empresa"
    },
    "nome_fantasia": {
      "type": "string",
      "description": "Nome comercial/marca pelo qual o fabricante e conhecido"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ da empresa"
    },
    "user_id": {
      "type": "string",
      "description": "ID do User vinculado a este fabricante. VAZIO = fabricante gerenciado somente pelo admin, sem login proprio. Preenchido depois para dar acesso ao fabricante."
    },
    "email": {
      "type": "string",
      "description": "Email comercial de contato"
    },
    "contato_nome": {
      "type": "string",
      "description": "Nome da pessoa de contato na fabrica"
    },
    "whatsapp": {
      "type": "string",
      "description": "WhatsApp comercial"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone comercial"
    },
    "site": {
      "type": "string",
      "description": "Website da empresa"
    },
    "endereco": {
      "type": "string",
      "description": "Endereco completo"
    },
    "cidade": {
      "type": "string",
      "description": "Cidade"
    },
    "estado": {
      "type": "string",
      "description": "Estado (UF)"
    },
    "logomarca": {
      "type": "string",
      "description": "URL da logomarca"
    },
    "historia_empresa": {
      "type": "string",
      "description": "Historia e descricao da empresa"
    },
    "formas_pagamento": {
      "type": "string",
      "description": "Formas de pagamento aceitas"
    },
    "condicoes_pagamento": {
      "type": "string",
      "description": "Condicoes de pagamento exibidas na tabela"
    },
    "prazo_entrega": {
      "type": "string",
      "description": "Prazo de entrega padrao"
    },
    "prazo_producao": {
      "type": "string",
      "description": "Prazo de producao exibido na tabela"
    },
    "informacoes_frete": {
      "type": "string",
      "description": "Informacoes de frete exibidas na tabela"
    },
    "politica_troca": {
      "type": "string",
      "description": "Politica de trocas e devolucoes"
    },
    "instrucoes_agente_ia": {
      "type": "string",
      "description": "Instrucoes customizadas para o agente de IA"
    },
    "aprovado": {
      "type": "boolean",
      "default": false,
      "description": "Se o fabricante foi aprovado pelo admin e aparece no catalogo"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o cadastro esta ativo"
    },
    "observacoes_admin": {
      "type": "string",
      "description": "Notas internas do admin, nao exibidas ao fabricante"
    }
  },
  "required": [
    "razao_social"
  ],
  "x-security": {
    "read": "authenticated",
    "create": "admin",
    "update": "authenticated",
    "delete": "admin"
  },
  "rls": {
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}